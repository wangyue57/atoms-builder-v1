# Copy with `npm run setup`: local credentials are generated into ignored .env.
COMPOSE_PROJECT_NAME=atoms-builder
POSTGRES_DB=atoms
POSTGRES_USER=atoms
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
POSTGRES_ADMIN_PASSWORD=replace-with-another-long-random-hex-password
POSTGRES_PORT=54329
DATABASE_URL=postgresql://atoms:replace-with-a-long-random-hex-password@127.0.0.1:54329/atoms
TEST_DATABASE_URL=postgresql://atoms:replace-with-a-long-random-hex-password@127.0.0.1:54329/atoms_test
PORT=8787
HOST=127.0.0.1
APP_PORT=8787
APP_ORIGIN=http://localhost:8787
COOKIE_SECURE=false
# DSKEY is read only by backend processes. Set in your shell or secret manager.
# DSKEY=
DEEPSEEK_MODEL=deepseek-flash
MODEL_TIMEOUT_MS=120000
# Server deployment uses the same compose and application image. For HTTPS:
# APP_DOMAIN=builder.example.com
# APP_ORIGIN=https://builder.example.com
# COOKIE_SECURE=true
APP_IMAGE=atoms-builder:local
